# Copy this to .env.local and fill in values. .env.local is gitignored (*.local in .gitignore).

# Required: Postgres connection string.
# Option A (fastest): Neon free tier — https://neon.tech → create project → copy "Pooled connection" string.
# Option B: Local Postgres — e.g. postgresql://postgres:postgres@localhost:5432/pokerledger
DATABASE_URL=

# Optional: only needed if you later wire in Gemini features.
GEMINI_API_KEY=
